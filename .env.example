# Supabase — copie este arquivo para `.env` e preencha com as chaves do seu projeto.
# Painel: https://supabase.com/dashboard -> Project Settings -> API

# Usadas pelo servidor (SSR / server functions)
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Expostas ao cliente (prefixo VITE_ é embutido no bundle do navegador).
# Use a chave anon/publishable — NUNCA a service_role aqui.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# OPCIONAL — chave service_role (bypassa RLS). Hoje o app NÃO usa
# (src/integrations/supabase/client.server.ts existe mas não é importado).
# Só preencha se for usar operações admin server-side. Mantenha em segredo:
# nunca exponha no cliente nem comite.
SUPABASE_SERVICE_ROLE_KEY=""
